{
  "name": "personal-code-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript coding agent inspired by pi",
  "os": ["linux"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "pnpm build && tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
